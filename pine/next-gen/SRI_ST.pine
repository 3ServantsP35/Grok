// SRI — Short Timeframe (ST)  ·  next-gen: + Reversal Band Projection
// Purpose: Trade Construction/Strategy — PRIMARY for execution
// Settings: Reversal Band: 4 Hours, Fast Trackline: 2 Hours, Slow Trackline: 1 Day
// © RizenShine — Fixed timeframe variant by CIO

//@version=6
indicator(title="SRI ST (Short)", shorttitle="SRI ST", overlay=true, max_lines_count=100, max_labels_count=100)

// ─── REVERSAL BAND (4 Hours) ───
string tf_rb = "240"
int length = input.int(50, title="Regression Length", minval=2)
float multiplier = input.float(1.0, title="Deviation Multiplier")
int rsiLength = input.int(14, title="RSI Length for Bear Condition")

f_compute_af() =>
    robustFit = ta.linreg(close, length, 0)
    dev = multiplier * ta.stdev(close, length)
    support = robustFit - dev
    resistance = robustFit + dev
    rsiVal = ta.rsi(close, rsiLength)
    if rsiVal < 50
        resistance := robustFit
    [support, robustFit, resistance]

[support_tf, robustFit_tf, resistance_tf] = request.security(syminfo.tickerid, tf_rb, f_compute_af())

plot(support_tf, color=color.red, title="ST Reversal Support", linewidth=2)
plot(robustFit_tf, color=color.blue, title="ST Reversal Robust Fit", linewidth=2)
plot(resistance_tf, color=color.new(color.green, 0), title="ST Reversal Resistance", linewidth=2, style=plot.style_line)

// ─── REVERSAL BAND PROJECTION (toggle-able, next-gen addition) ───
// Rolls the SAME window mechanics the live band already uses: each simulated
// step forward drops the single oldest real bar from the regression exactly
// as it would live, and admits a synthetic bar assumed to mirror the current
// close (flat continuation) in its place. This is a scenario projection, not
// a price forecast -- it shows where the fit goes IF price holds near today's
// level, using the regression's own math. It converges to a flat line once
// every bar in the window is synthetic (at 'length' bars out) -- that is this
// projection's own honest reliability horizon, not an arbitrary cutoff.
// The live band's RSI<50 resistance clamp is NOT replicated here (would need
// hand-rolled RSI recursion on a synthetic series -- deferred, same class of
// problem as the tracklines). Projected resistance is always the wider,
// unclamped band.
gProj = "Reversal Band Projection"
show_projection = input.bool(true, "Show Reversal Band Projection", group=gProj,
     tooltip="Projects the Reversal Band forward assuming every future bar mirrors the current close (flat continuation). Converges to flat at 'Regression Length' bars out -- that is the projection's own reliability horizon.")

f_project_reversal_band() =>
    int nSamp = 10
    float lastC = close
    array<int> kList = array.new_int(0)
    for i = 0 to nSamp - 1
        array.push(kList, int(i * length / nSamp))
    array.push(kList, length)

    array<float> fitArr = array.new_float(0)
    array<float> supArr = array.new_float(0)
    array<float> resArr = array.new_float(0)

    for ki = 0 to array.size(kList) - 1
        int k = array.get(kList, ki)
        float sumX = 0.0
        float sumY = 0.0
        float sumXY = 0.0
        float sumX2 = 0.0
        for x = 0 to length - 1
            float y = x < length - k ? nz(close[(length - k - 1) - x], lastC) : lastC
            sumX  += x
            sumY  += y
            sumXY += x * y
            sumX2 += x * x
        float denom = length * sumX2 - sumX * sumX
        float slope = denom != 0 ? (length * sumXY - sumX * sumY) / denom : 0.0
        float intercept = (sumY - slope * sumX) / length
        float fit = intercept + slope * (length - 1)
        float mean = sumY / length
        float sumSq = 0.0
        for x = 0 to length - 1
            float y = x < length - k ? nz(close[(length - k - 1) - x], lastC) : lastC
            sumSq += math.pow(y - mean, 2)
        float dv = multiplier * math.sqrt(sumSq / length)
        array.push(fitArr, fit)
        array.push(supArr, fit - dv)
        array.push(resArr, fit + dv)

    // Return the sample arrays only on the last bar. Handing back populated array
    // IDs from every historical bar is the RE10139 memory-blowout pattern and can
    // also come back empty/na (=> the draw block below silently skips, no error).
    [barstate.islast ? fitArr : na, barstate.islast ? supArr : na, barstate.islast ? resArr : na]

// Computed unconditionally in global scope (request.*() inside a conditional would
// require dynamic_requests=true). The show_projection toggle gates all drawing below.
// projK (the sample offsets) is deterministic, so it is rebuilt here rather than
// transported through the request.
[projFit, projSup, projRes] = request.security(syminfo.tickerid, tf_rb, f_project_reversal_band())
array<int> projK = array.new_int(0)
for pk = 0 to 9
    array.push(projK, int(pk * length / 10))
array.push(projK, length)

var line[]  projFitLines = array.new_line(0)
var line[]  projSupLines = array.new_line(0)
var line[]  projResLines = array.new_line(0)
var label   projEndLabel = na

if barstate.islast
    // for...in no-ops on an empty array; `for i = 0 to size-1` does NOT --
    // Pine reverses the step when from > to, so `0 to -1` runs with i=0.
    for ln in projFitLines
        line.delete(ln)
    for ln in projSupLines
        line.delete(ln)
    for ln in projResLines
        line.delete(ln)
    array.clear(projFitLines)
    array.clear(projSupLines)
    array.clear(projResLines)
    label.delete(projEndLabel)

    if show_projection and not na(projFit) and array.size(projFit) > 1
        int htfSec = timeframe.in_seconds(tf_rb)
        int nowT   = time
        for ii = 0 to array.size(projK) - 2
            int k0 = array.get(projK, ii)
            int k1 = array.get(projK, ii + 1)
            int t0 = nowT + k0 * htfSec * 1000
            int t1 = nowT + k1 * htfSec * 1000
            array.push(projFitLines, line.new(t0, array.get(projFit, ii), t1, array.get(projFit, ii + 1), xloc=xloc.bar_time, color=color.new(color.blue, 20), style=line.style_dashed, width=2))
            array.push(projSupLines, line.new(t0, array.get(projSup, ii), t1, array.get(projSup, ii + 1), xloc=xloc.bar_time, color=color.new(color.red, 55), style=line.style_dotted, width=1))
            array.push(projResLines, line.new(t0, array.get(projRes, ii), t1, array.get(projRes, ii + 1), xloc=xloc.bar_time, color=color.new(color.green, 55), style=line.style_dotted, width=1))
        int lastIdx = array.size(projK) - 1
        int lastK   = array.get(projK, lastIdx)
        int lastT   = nowT + lastK * htfSec * 1000
        projEndLabel := label.new(lastT, array.get(projFit, lastIdx),
             str.format("ST projected fit -- flat-continuation, {0} bars out (window fully synthetic)", lastK),
             style=label.style_label_left, color=color.new(color.blue, 70), textcolor=color.white, size=size.small, xloc=xloc.bar_time)
// --- END of Reversal Band Projection ---

// ─── FAST TRACKLINE (2 Hours) ───
string tf_fast = "120"
float at_coeff_1 = input.float(1.0, "Fast Trackline Coeff")
int at_period_1 = input.int(14, "Fast Trackline Period")

f_compute_stage_1() =>
    atr = ta.rma(ta.tr(true), at_period_1)
    upT = low - atr * at_coeff_1
    downT = high + atr * at_coeff_1
    cond = ta.rsi(close, at_period_1) >= 50
    var float stage_track = 0.0
    stage_track := cond ? math.max(upT, nz(stage_track[1])) : math.min(downT, nz(stage_track[1]))
    stage_track

float stage_track_tf_1 = request.security(syminfo.tickerid, tf_fast, f_compute_stage_1())
color stage_color_1 = stage_track_tf_1 > nz(stage_track_tf_1[1]) ? color.green : stage_track_tf_1 < nz(stage_track_tf_1[1]) ? color.red : color.orange
plot(stage_track_tf_1, color=stage_color_1, linewidth=2, title="ST Fast Trackline", style=plot.style_circles)

// ─── SLOW TRACKLINE (1 Day) ───
string tf_slow = "D"
float at_coeff_2 = input.float(1.0, "Slow Trackline Coeff")
int at_period_2 = input.int(14, "Slow Trackline Period")

f_compute_stage_2() =>
    atr = ta.rma(ta.tr(true), at_period_2)
    upT = low - atr * at_coeff_2
    downT = high + atr * at_coeff_2
    cond = ta.rsi(close, at_period_2) >= 50
    var float stage_track = 0.0
    stage_track := cond ? math.max(upT, nz(stage_track[1])) : math.min(downT, nz(stage_track[1]))
    stage_track

float stage_track_tf_2 = request.security(syminfo.tickerid, tf_slow, f_compute_stage_2())
color stage_color_2 = stage_track_tf_2 > nz(stage_track_tf_2[1]) ? color.green : stage_track_tf_2 < nz(stage_track_tf_2[1]) ? color.red : color.orange
plot(stage_track_tf_2, color=stage_color_2, linewidth=2, title="ST Slow Trackline")

// ─── STAGE TRANSITION DETECTION ───
int stoch_length = 14
float stochK = ta.stoch(close, high, low, stoch_length)
float stochD = ta.sma(stochK, 3)
float mtf_rsi = request.security(syminfo.tickerid, tf_slow, ta.rsi(close, 14))

float slow_slope = (stage_track_tf_2 - stage_track_tf_2[5]) / 5.0
bool slow_up = slow_slope > 0.5
bool slow_down = slow_slope < -0.5
bool slow_sideways = math.abs(slow_slope) <= 0.5

bool fast_slow_crossover = ta.crossover(stage_track_tf_1, stage_track_tf_2)
bool stochK_D_crossover = ta.crossover(stochK, stochD)
bool close_resistance_crossover = ta.crossover(close, resistance_tf)
float mtf_rsi_change = ta.change(mtf_rsi)
bool fast_slow_crossunder = ta.crossunder(stage_track_tf_1, stage_track_tf_2)
bool stochD_K_crossunder = ta.crossunder(stochD, stochK)
bool close_support_crossunder = ta.crossunder(close, support_tf)

bool price_bounce_support = ta.crossover(close, support_tf) and close[1] < support_tf
bool price_reject_resistance = ta.crossunder(close, resistance_tf) and close[1] > resistance_tf

var int below_support_count = 0
below_support_count := close < support_tf ? below_support_count + 1 : 0
bool not_below_support_long = below_support_count <= 2

var int above_resistance_count = 0
above_resistance_count := close > resistance_tf ? above_resistance_count + 1 : 0
bool not_above_resistance_long = above_resistance_count <= 3

bool stage4_to1 = (slow_sideways or slow_down) and fast_slow_crossover and stochK_D_crossover and (support_tf > robustFit_tf) and price_bounce_support and not_below_support_long and mtf_rsi < 30
bool stage1_to2 = slow_sideways and (stage_track_tf_1 > stage_track_tf_2) and (stochK > 80) and (robustFit_tf > stage_track_tf_2) and (support_tf > stage_track_tf_2) and close_resistance_crossover and not_above_resistance_long and mtf_rsi > 30 and mtf_rsi_change > 0
bool stage2_to3 = ((slow_up and slow_slope < slow_slope[1]) or slow_sideways) and fast_slow_crossunder and stochD_K_crossunder and (resistance_tf < robustFit_tf) and price_reject_resistance and not_above_resistance_long and mtf_rsi > 70
bool stage3_to4 = slow_sideways and (stage_track_tf_1 < stage_track_tf_2) and (stochD < 20) and (resistance_tf < stage_track_tf_2) and (robustFit_tf < stage_track_tf_2) and close_support_crossunder and (mtf_rsi_change < 0) and mtf_rsi < 70

plotshape(stage4_to1, title="ST Stage 4 to 1", location=location.belowbar, color=color.green, style=shape.labelup, text="ST 4→1", textcolor=color.white, size=size.small)
plotshape(stage1_to2, title="ST Stage 1 to 2", location=location.belowbar, color=color.lime, style=shape.labelup, text="ST 1→2", textcolor=color.black, size=size.small)
plotshape(stage2_to3, title="ST Stage 2 to 3", location=location.abovebar, color=color.orange, style=shape.labeldown, text="ST 2→3", textcolor=color.white, size=size.small)
plotshape(stage3_to4, title="ST Stage 3 to 4", location=location.abovebar, color=color.red, style=shape.labeldown, text="ST 3→4", textcolor=color.white, size=size.small)

if stage4_to1
    alert("ST Stage 4→1 (Bottoming): Trade construction signal. Primary execution timeframe.", alert.freq_once_per_bar_close)
if stage1_to2
    alert("ST Stage 1→2 (Bull): Trade construction. Build positions per bucket framework.", alert.freq_once_per_bar_close)
if stage2_to3
    alert("ST Stage 2→3 (Topping): Adjust spreads. Shift Bucket 2 bearish.", alert.freq_once_per_bar_close)
if stage3_to4
    alert("ST Stage 3→4 (Bear): Execute defensive. Close bullish positions.", alert.freq_once_per_bar_close)
